:8080 {
	encode zstd gzip
	log {
		output stdout
		format json
	}
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self'; img-src 'self' data: https://images.unsplash.com; script-src 'self'; style-src 'self'; style-src-elem 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'"
	}
	handle /api/* {
		reverse_proxy controller:8080
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
