[Unit]
Description=Update MyPanel from its tracked GitHub branch
After=docker.service network-online.target
Wants=network-online.target
ConditionPathIsDirectory=%h/MyPanel-V2/.git

[Service]
Type=oneshot
WorkingDirectory=%h/MyPanel-V2
ExecStart=/bin/sh %h/MyPanel-V2/scripts/update.sh
TimeoutStartSec=30min
NoNewPrivileges=true

[Install]
WantedBy=default.target
